# --- Google Gemini ---
# Obten tu API key en: https://aistudio.google.com/apikey
GOOGLE_API_KEY=""

# --- Groq ---
# Obten tu API key en: https://console.groq.com/keys
GROQ_API_KEY=""

# --- LM Studio (opcional) ---
# Solo si tu servidor LM Studio no esta en localhost:1234/v1
# LMSTUDIO_BASE_URL="http://localhost:1234/v1"
# LMSTUDIO_API_KEY=""

# --- Proxy (opcional) ---
# HTTP_PROXY="http://proxy:8080"
# HTTPS_PROXY="http://proxy:8080"
